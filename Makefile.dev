PODMAN ?= podman
DEV_IMAGE ?= localhost/ioplane-prism-go-client:dev
SOURCE_REVISION := $(shell git rev-parse HEAD)
DEV_RUN = $(PODMAN) run --rm -v $(CURDIR):/src:z -w /src \
	-v ioplane-nutanix-driver-go-modules:/cache/modules \
	-v ioplane-nutanix-driver-go-build:/cache/build --env GOVERNANCE_TITLE --env GOVERNANCE_TITLES $(DEV_IMAGE)

# These existing integration tests require the external Keploy server on :6789.
KEPLOY_V3 = TestOperations_(CreateRecoveryPlan|GetRecoveryPlan|ListRecoveryPlans|UpdateRecoveryPlans|DeleteRecoveryPlan|GetPrismCentral|ListSubnet|GetSubnet|GetCluster|ListCluster|CreateIdempotenceIdentifers|GetIdempotenceIdentifers|DeleteIdempotenceIdentifers|CreateVM|GetVM|ListVM|UpdateVM)
KEPLOY_KONNECTOR = TestKonnector(CreateClusterRegistration|UpdateClusterRegistration|CreateClusterRegistrationWithNoCategory|CreateClusterRegistrationWithNoUUID|CreateClusterRegistrationWithNoK8sDistribution|CreateClusterRegistrationAndSetInfo|CreateClusterRegistrationAndAddonSetInfo|GetK8sRegistrationList|CreateClusterRegistrationAndSetMetrics)|TestMetaOperations_(GetVersion|GetSemanticVersion)

.PHONY: dev-build regression unit unit-all vet fmt-check build mod-check vuln check
dev-build:
	$(PODMAN) build --build-arg SOURCE_REVISION=$(SOURCE_REVISION) -t $(DEV_IMAGE) -f Containerfile.dev .
regression:
	$(DEV_RUN) go test -race -count=5 -run 'TestNewClient(TransportIsolation|UnsupportedDefaultTransport)$$' ./internal
unit:
	$(DEV_RUN) go test -race -shuffle=on -covermode=atomic -skip '^($(KEPLOY_V3))$$' ./internal ./v3
unit-all:
	$(DEV_RUN) go test -p 2 -race -shuffle=on -covermode=atomic -skip '^($(KEPLOY_V3)|$(KEPLOY_KONNECTOR))$$' ./...
vet:
	$(DEV_RUN) go vet ./...
fmt-check:
	$(DEV_RUN) sh -ec 'test -z "$$(gofmt -l internal/client.go internal/client_transport_test.go internal/client_response_test.go internal/client_benchmark_test.go v3/cache_benchmark_test.go .ci)"'
build:
	$(DEV_RUN) go build ./...
mod-check:
	$(DEV_RUN) go mod tidy -diff
	$(DEV_RUN) go mod verify
vuln:
	$(DEV_RUN) go tool govulncheck ./...
check: governance mod-check fmt-check regression unit-all benchmark-check vet build vuln

.PHONY: benchmark-check benchmark
benchmark-check:
	$(DEV_RUN) go test -race -run '^$$' -bench '^BenchmarkClient' -benchtime=2x ./internal ./v3

benchmark:
	$(DEV_RUN) go test -cpu=4 -run '^$$' -bench '^BenchmarkClient' -benchmem -benchtime=100ms -count=5 ./internal ./v3

.PHONY: governance
governance:
	$(DEV_RUN) go test -race ./.ci
	$(DEV_RUN) go vet ./.ci
	$(DEV_RUN) go run ./.ci
